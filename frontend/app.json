{
  "expo": {
    "name": "Conexia CLM",
    "slug": "conexia-clm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/conexia-logo.png",
    "scheme": "conexia",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Capturar evidencias en campo con timestamp",
        "NSPhotoLibraryUsageDescription": "Seleccionar fotos como evidencia contractual",
        "NSLocationWhenInUseUsageDescription": "Geolocalizar evidencias en sitio"
      },
      "bundleIdentifier": "com.emergent.contractforge.crdkce"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/conexia-logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "package": "com.emergent.contractforge.crdkce"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/conexia-logo.png",
      "name": "Conexia CLM",
      "shortName": "Conexia",
      "description": "Contract Lifecycle Management enterprise SaaS",
      "themeColor": "#1F4A4A",
      "backgroundColor": "#FFFFFF",
      "lang": "es",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/conexia-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-localization",
      "expo-mail-composer"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
